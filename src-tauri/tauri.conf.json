{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibreJob",
  "version": "0.3.2",
  "identifier": "dev.luisfer.librejob",
  "build": {
    "beforeDevCommand": "bun run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist/librejob/browser"
  },
  "app": {
    "windows": [
      {
        "title": "LibreJob",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:librejob.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyQjE3MTQ2NzRDRENBRkMKUldUOHlzMTBSbkd4c2t4WHI3dXRMVVFPVFcyMmJPNlRLb3RWT215c3lIWUlzMjhDRENyMkhqOVMK",
      "endpoints": [
        "https://github.com/luisfer-cli/librejob/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
